# The site needs no keys: everything it shows is public data in ../data. These optional settings are set by the
# deploy workflow (.github/workflows/deploy.yml); copy this file to `.env` (git-ignored) only to try them locally.

# The release shown in the site's footer, linked to its notes, e.g. 1.24.0 (local builds have none).
PUBLIC_VERSION=
# When the last sweep checked Instagram, e.g. 2026-10-05T21:25:00-05:00 (otherwise meta.json's generated_at).
PUBLIC_CHECKED_AT=
