---
// One page per event (/evento/<id>/): what a shared link opens. Its link preview (WhatsApp, Instagram,
// iMessage, Telegram, Facebook) shows the event's date in the title, what, where and the price in the
// description, and its image (pages/og/[id].jpg.ts); search engines get the event as schema.org data.
// Same detail markup as the home page's dialog (scripts/views/eventDetail.ts).
import BaseLayout from "../../layouts/BaseLayout.astro";
import InstallOffer from "../../components/InstallOffer.astro";
import PostViewer from "../../components/PostViewer.astro";
import PostsSheet from "../../components/PostsSheet.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Stripes from "../../components/Stripes.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import { allowInlineScript, jsValue } from "../../csp";
import { accounts, events } from "../../data";
import { isMultiDay, lastDay, todayIso } from "../../scripts/lib/dates";
import type { DanceEvent } from "../../scripts/types";
import {
  PREVIEW_HEIGHT,
  PREVIEW_WIDTH,
  previewDescription,
  previewImageAlt,
  previewTitle,
  previewVersion,
} from "../../scripts/lib/linkPreview";
import { BASE_URL, eventPageUrl, eventTimes, flyerUrl, mainMedia, previewImagePath } from "../../scripts/lib/links";
import { eventDetailHtml } from "../../scripts/views/eventDetail";

export function getStaticPaths() {
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: DanceEvent;
}

const { event } = Astro.props;
const home = BASE_URL;
const today = todayIso();
const isPast = lastDay(event) < today; // over several days: once its last day has passed

// The link preview: "Intensivo Ritmos Cubanos — dom 4 oct, 9:00 a. m.", "Taller de salsa cubana · Cra 16 #52-46 ·
// Desde $ 35.000 · Pa' Bailar", and the image with its version (it changes when the image does).
const description = previewDescription(event);
const previewImage = {
  path: previewImagePath(event, previewVersion(event)),
  width: PREVIEW_WIDTH,
  height: PREVIEW_HEIGHT,
  type: "image/jpeg",
  alt: previewImageAlt(event),
};

// schema.org Event (https://schema.org/Event), as search engines read it.
const { start, end, allDay } = eventTimes(event);
const isoDateTime = (value: string) =>
  allDay
    ? `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}`
    : `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}T${value.slice(9, 11)}:${value.slice(11, 13)}:00-05:00`;
const flyer = flyerUrl(mainMedia(event));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  startDate: isoDateTime(start),
  // Over several days: the last day (schema.org's endDate is inclusive, unlike the calendar's exclusive end).
  ...(isMultiDay(event) ? { endDate: lastDay(event) } : allDay ? {} : { endDate: isoDateTime(end) }),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  url: eventPageUrl(event),
  ...(flyer ? { image: [new URL(flyer, Astro.site).href] } : {}),
  location: {
    "@type": "Place",
    name: event.venue ?? event.organizer ?? `@${event.account}`,
    address: {
      "@type": "PostalAddress",
      ...(event.address ? { streetAddress: event.address } : {}),
      addressLocality: "Bogotá",
      addressCountry: "CO",
    },
  },
  organizer: { "@type": "Organization", name: event.organizer ?? `@${event.account}`, url: `https://www.instagram.com/${event.account}/` },
  ...(event.prices.length
    ? {
        offers: event.prices.map((price) => ({
          "@type": "Offer",
          name: price.label,
          price: price.amount_cop,
          priceCurrency: "COP",
          url: mainMedia(event).permalink,
        })),
      }
    : {}),
};
// A shared link lands in the app, with this event open in the viewer (main.ts, openSharedEvent), so the visitor
// sees it the way they'd see it from the list and can swipe to the others. This page stays for link previews and
// search engines (they read it, they don't run it) and for browsers without scripts. Replacing it in the history
// means "back" never comes here to bounce again. Inline, allowed by its hash (csp.ts).
const redirectScript = allowInlineScript(
  Astro,
  `if (!/bot|crawl|spider|slurp|facebookexternalhit|preview/i.test(navigator.userAgent)) {
  var params = new URLSearchParams(location.search);
  params.set("evento", ${jsValue(event.id)});
  location.replace(${jsValue(home)} + "?" + params.toString());
}`,
);
---

<BaseLayout title={`${event.title} · Pa' Bailar`} previewTitle={previewTitle(event)} description={description} image={previewImage}>
  <script slot="head" type="application/ld+json" set:html={jsValue(structuredData)} />
  <!-- Opens the event in the app (redirectScript, above). -->
  <script slot="head" is:inline set:html={redirectScript} />

  <header class="container event-page__header">
    <div class="site-header__top">
      <Stripes />
      <ThemeToggle />
    </div>
    <a class="event-page__logo" href={home}>Pa' Bailar</a>
    <a class="event-page__back" href={home}>← Ver todos los eventos</a>
  </header>

  <main class="container">
    {isPast && <p class="callout event-page__past">Este evento ya pasó.</p>}
    <article class="event-page event-dialog__layout" id="event-detail" set:html={eventDetailHtml(event, 0, { headingLevel: 1 })} />
  </main>

  <SiteFooter accounts={accounts} />
  <PostsSheet />
  <PostViewer />
  <InstallOffer />

  <script type="application/json" id="event-data" set:html={jsValue(event)} />
  <script>
    import { initEventPage } from "../../scripts/eventPage";
    initEventPage();
  </script>
</BaseLayout>
