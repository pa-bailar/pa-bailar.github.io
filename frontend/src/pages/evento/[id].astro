---
// One page per event (/evento/<id>/): what a shared link opens. Its link preview (WhatsApp, Instagram,
// iMessage, Telegram, Facebook) shows the event's date in the title, what, where and the price in the
// description, and its image (pages/og/[id].jpg.ts); search engines get the event as schema.org data.
// The flyer on top, as on its card, then the same details as the home page's drawer (scripts/views/eventDetail.ts).
import BaseLayout from "../../layouts/BaseLayout.astro";
import InstallOffer from "../../components/InstallOffer.astro";
import Notice from "../../components/Notice.astro";
import PostViewer from "../../components/PostViewer.astro";
import PostsSheet from "../../components/PostsSheet.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Stripes from "../../components/Stripes.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import { allowInlineScript, jsValue } from "../../csp";
import { accounts, events } from "../../data";
import { endsAt, isMultiDay, isSeries, isUpcoming, lastDay, todayIso } from "../../scripts/lib/dates";
import type { DanceEvent } from "../../scripts/types";
import {
  PREVIEW_HEIGHT,
  PREVIEW_WIDTH,
  previewDescription,
  previewImageAlt,
  previewTitle,
  previewVersion,
} from "../../scripts/lib/linkPreview";
import {
  BASE_URL,
  eventPageUrl,
  eventTimes,
  flyerUrl,
  mainMedia,
  previewImagePath,
  profileUrl,
  sessionTimes,
  type EventTimes,
} from "../../scripts/lib/links";
import { eventDetailHtml } from "../../scripts/views/eventDetail";

export function getStaticPaths() {
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: DanceEvent;
}

const { event } = Astro.props;
const home = BASE_URL;
const today = todayIso();
const isPast = !isUpcoming(event, today); // over several days: once its last day has passed (set again by eventPage.ts)

// The link preview: "Intensivo Ritmos Cubanos — dom 4 oct, 9:00 a. m.", "Taller de salsa cubana · Cra 16 #52-46 ·
// Desde $ 35.000 · Pa' Bailar", and the image with its version (it changes when the image does).
const description = previewDescription(event);
const previewImage = {
  path: previewImagePath(event, previewVersion(event)),
  width: PREVIEW_WIDTH,
  height: PREVIEW_HEIGHT,
  type: "image/jpeg",
  alt: previewImageAlt(event),
};

// schema.org Event (https://schema.org/Event), as search engines read it.
const { start, end, allDay } = eventTimes(event);
const isoDate = (value: string) => `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}`;
const isoDateTime = (value: string, day: boolean = allDay) =>
  day ? isoDate(value) : `${isoDate(value)}T${value.slice(9, 11)}:${value.slice(11, 13)}:00-05:00`;
const flyer = flyerUrl(mainMedia(event));
const location = {
  "@type": "Place",
  name: event.venue ?? event.organizer ?? `@${event.account}`,
  address: {
    "@type": "PostalAddress",
    ...(event.address ? { streetAddress: event.address } : {}),
    addressLocality: "Bogotá",
    addressCountry: "CO",
  },
};
// A workshop series: one Event from its first session to its last (what Google reads: startDate and endDate), with each
// session as a `subEvent` of its own (schema.org's way to say which days; Google doesn't use it, but it's valid). As for
// one day, a session's end only when the post gives it.
const series = isSeries(event)
  ? sessionTimes(event).map((times: EventTimes, index) => ({ times, session: event.sessions![index]! }))
  : [];
const sessionEnd = ({ times, session }: (typeof series)[number]) =>
  session.start_time && session.end_time ? isoDateTime(times.end, false) : null;
const subEvents = series.map((item, index) => ({
  "@type": "Event",
  name: `${event.title} (sesión ${index + 1} de ${series.length})`,
  startDate: isoDateTime(item.times.start, item.times.allDay),
  ...(sessionEnd(item) ? { endDate: sessionEnd(item) } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location,
}));
const lastSession = series.at(-1);
const endDate = isMultiDay(event)
  ? { endDate: lastDay(event) }
  : lastSession
    ? { endDate: sessionEnd(lastSession) ?? lastSession.session.date }
    : allDay || !event.end_time
      ? {}
      : { endDate: isoDateTime(end) };
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  startDate: isoDateTime(start),
  // Over several days: the last day (schema.org's endDate is inclusive, unlike the calendar's exclusive end); a series:
  // its last session's end, or day. One day: only the end the post gives (the calendar's guessed 4 hours aren't a fact
  // to tell search engines).
  ...endDate,
  ...(subEvents.length ? { subEvent: subEvents } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  url: eventPageUrl(event),
  ...(flyer ? { image: [new URL(flyer, Astro.site).href] } : {}),
  location,
  organizer: { "@type": "Organization", name: event.organizer ?? `@${event.account}`, url: profileUrl(event.account) },
  ...(event.prices.length
    ? {
        offers: event.prices.map((price) => ({
          "@type": "Offer",
          name: price.label,
          price: price.amount_cop,
          priceCurrency: "COP",
          url: mainMedia(event).permalink,
        })),
      }
    : {}),
};
// A shared link lands in the app: the list at this event's card, with its details open over it (main.ts,
// openSharedEvent), as if the visitor had tapped it. This page stays for link previews and search engines (they
// read it, they don't run it), for browsers without scripts, and for an event that already passed (it's not in the
// list): the time is checked here, in Bogotá (UTC−5 all year), since the page was built earlier: past once it's over
// (endsAt: the end of its last day, or a night past midnight's end time the morning after). `?pagina` (the app sending a
// visitor back here) also stays. Replacing it in the history means "back" never comes here to bounce again.
// Inline, allowed by its hash (csp.ts).
const redirectScript = allowInlineScript(
  Astro,
  `(function () {
  var params = new URLSearchParams(location.search);
  if (/bot|crawl|spider|slurp|facebookexternalhit|preview/i.test(navigator.userAgent) || params.has("pagina")) return;
  var now = new Date(Date.now() - 5 * 3600000).toISOString().slice(0, 16).replace("T", " ");
  if (now >= ${jsValue(endsAt(event))}) return;
  params.set("evento", ${jsValue(event.id)});
  location.replace(${jsValue(home)} + "?" + params.toString());
})();`,
);
---

<BaseLayout title={`${event.title} · Pa' Bailar`} previewTitle={previewTitle(event)} description={description} image={previewImage}>
  <script slot="head" type="application/ld+json" set:html={jsValue(structuredData)} />
  <!-- Opens the event in the app (redirectScript, above). -->
  <script slot="head" is:inline set:html={redirectScript} />

  <header class="container event-page__header">
    <div class="site-header__top">
      <Stripes />
      <ThemeToggle />
    </div>
    <a class="event-page__logo" href={home}>Pa' Bailar</a>
    <a class="event-page__back" href={home}>← Ver próximos eventos</a>
  </header>

  <main class="container">
    <p class="callout event-page__past" id="event-past" hidden={!isPast}>Este evento ya pasó.</p>
    <article class="event-page event-detail__layout" id="event-detail" set:html={eventDetailHtml(event, 0)} />
  </main>

  <SiteFooter accounts={accounts} />
  <PostsSheet />
  <PostViewer />
  <InstallOffer />
  <Notice />

  <script type="application/json" id="event-data" set:html={jsValue(event)} />
  <script>
    import { initEventPage } from "../../scripts/eventPage";
    initEventPage();
  </script>
</BaseLayout>
