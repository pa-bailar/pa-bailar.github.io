---
// /finde/: what a shared "este finde" link opens. Its link preview (WhatsApp, Instagram, Facebook) is the
// weekend image (/finde.jpg, src/weekendImage.ts), and it leads to the events.
import BaseLayout from "../layouts/BaseLayout.astro";
import Stripes from "../components/Stripes.astro";
import { events } from "../data";
import { todayIso } from "../scripts/lib/dates";
import { eventCountLabel } from "../scripts/lib/format";
import { BASE_URL } from "../scripts/lib/links";
import { weekendEvents } from "../scripts/lib/weekend";

const weekend = weekendEvents(events, todayIso());
const description = weekend.length
  ? `${eventCountLabel(weekend.length)} este fin de semana en Bogotá: ${weekend.map((event) => event.title).slice(0, 3).join(", ")}…`
  : "Sociales y talleres de baile en Bogotá.";
---

<BaseLayout title="Este finde en Bogotá · Pa' Bailar" description={description} image="finde.jpg">
  <main class="container finde-page">
    <Stripes />
    <a class="event-page__logo" href={BASE_URL}>Pa' Bailar</a>
    <img class="finde-page__image" src={`${BASE_URL}finde.jpg`} width="1080" height="1350" alt={`Este finde en Bogotá: ${weekend.map((event) => event.title).join(", ") || "sociales y talleres de baile"}`} />
    <a class="btn btn--primary" href={BASE_URL}>Ver todos los eventos</a>
  </main>
</BaseLayout>

<style>
  .finde-page {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .finde-page__image {
    width: min(100%, 540px);
    height: auto;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
  }
</style>
