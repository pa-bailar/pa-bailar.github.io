---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalendarView from "../components/CalendarView.astro";
import EventDrawer from "../components/EventDrawer.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ViewToolbar from "../components/ViewToolbar.astro";
import JumpBar from "../components/JumpBar.astro";
import FilterSheet from "../components/FilterSheet.astro";
import InstallOffer from "../components/InstallOffer.astro";
import PostViewer from "../components/PostViewer.astro";
import PostsSheet from "../components/PostsSheet.astro";
import ViewSwitch from "../components/ViewSwitch.astro";
import { accounts, events, meta } from "../data";
import { LOCALE } from "../scripts/lib/format";

// Escape "<" so a caption can never end the inline JSON script block early.
const eventsJson = JSON.stringify(events).replace(/</g, "\\u003c");
// When the data was last checked: the backend's sweep passes PUBLIC_CHECKED_AT to the build; otherwise
// (local builds, code deploys) the time of the last data change recorded in meta.json.
const checkedAt = import.meta.env.PUBLIC_CHECKED_AT || meta.generated_at;
const updatedLabel = new Date(checkedAt).toLocaleDateString(LOCALE, {
  day: "numeric",
  month: "long",
  timeZone: "America/Bogota",
});
---

<BaseLayout
  title="Pa' Bailar · Bogotá"
  description="Sociales y talleres de baile en Bogotá: salsa, bachata, mambo y más, en un solo lugar."
  image={{
    path: "og/sitio.jpg",
    width: 1200,
    height: 630,
    type: "image/jpeg",
    alt: "Pa' Bailar: sociales y talleres de baile en Bogotá",
  }}
>
  <SiteHeader updatedLabel={updatedLabel} />
  <InstallOffer />
  <ViewToolbar />
  <JumpBar />

  <main class="container page-main">
    <section id="view-upcoming" role="tabpanel" aria-labelledby="tab-upcoming"></section>
    <CalendarView />
  </main>

  <SiteFooter accounts={accounts} />
  <EventDrawer />
  <PostsSheet />
  <PostViewer />
  <FilterSheet />
  <ViewSwitch />

  <script type="application/json" id="events-data" set:html={eventsJson} />
  <script>
    import { start } from "../scripts/main";
    start();
  </script>
</BaseLayout>
