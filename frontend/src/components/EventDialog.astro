---
// Event viewer: one slide per event on screen, swiped sideways (scripts/views/eventDialog.ts). On phones each
// slide is the event's flyer with a sheet over the lower part of the screen (half height, pulled up to the
// whole screen); on wide screens, a side panel next to the list. Each slide brings its own bar ("‹ 3 de 9 › ×"),
// at the top of the sheet.
---

<dialog class="sheet event-dialog" id="event-dialog" aria-labelledby="event-title-0" tabindex="-1">
  <div class="viewer-track" id="viewer-track"></div>
</dialog>
