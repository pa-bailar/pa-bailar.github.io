---
// Installing the site like an app (scripts/views/installPrompt.ts): the banner under the header (phones,
// dismissible) and the sheet with the steps for where the visitor is. Hidden until the script shows them.
import { BASE_URL } from "../scripts/lib/links";
---

<aside class="container install-banner" id="install-banner" aria-label="Instalar la app" hidden>
  <img class="install-banner__icon" src={`${BASE_URL}icons/192.png`} width="44" height="44" alt="" />
  <p class="install-banner__text"><b>Pa' Bailar en tu celular</b> Ábrelo como una app, sin pasar por la tienda.</p>
  <button class="btn btn--primary" type="button" data-install data-track="instalar">Instalar</button>
  <button class="icon-btn" type="button" data-install-dismiss aria-label="Ahora no">×</button>
</aside>

<!-- A one-time reminder after a second saved event, for whoever dismissed the banner. -->
<div class="install-nudge" id="install-nudge" role="status" hidden>
  <span>Tus guardados a un toque: instala Pa' Bailar.</span>
  <button class="link-button" type="button" data-install data-track="instalar">Instalar</button>
  <button class="icon-btn" type="button" data-nudge-close aria-label="Cerrar">×</button>
</div>

<dialog class="sheet sheet-panel install-sheet" id="install-sheet" aria-labelledby="install-sheet-title">
  <span class="sheet-handle" aria-hidden="true"></span>
  <div class="sheet-panel__head">
    <h2 class="sheet-panel__title" id="install-sheet-title">Instalar Pa' Bailar</h2>
    <button class="icon-btn" type="button" data-close-sheet aria-label="Cerrar">×</button>
  </div>
  <ol class="install-sheet__steps" id="install-steps"></ol>
  <p class="install-sheet__note">Pa' Bailar queda en tu pantalla de inicio y se abre como una app.</p>
</dialog>
