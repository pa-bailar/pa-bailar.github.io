---
import { ICONS } from "../scripts/lib/icons";
// Bar with the view tabs and, on wide screens, the filter chips and "12 eventos · Limpiar filtros" (rendered by
// scripts/views/filters.ts; phones have them in the jump bar). Sticky on wide screens only (see toolbar.css).
---

<div class="toolbar">
  <div class="container toolbar__inner">
    <div class="tabs-row">
      <div class="tabs" role="tablist" aria-label="Vista">
        <button class="tabs__tab" id="tab-upcoming" role="tab" aria-selected="true" aria-controls="view-upcoming" data-view="upcoming">
          Próximos
        </button>
        <button class="tabs__tab" id="tab-calendar" role="tab" aria-selected="false" aria-controls="view-calendar" data-view="calendar">
          Calendario
        </button>
      </div>
      <!-- Not a view: a link to the footer ("Sobre Pa' Bailar"), styled like the tabs beside it. -->
      <a class="tabs__tab tabs__link" href="#info">Info</a>
      <div class="toolbar__tools">
        <button class="chip toolbar__saved" type="button" data-saved-only aria-pressed="false" aria-label="Guardados">
          <Fragment set:html={ICONS.bookmark} />Guardados <span class="toolbar__saved-count" data-saved-count hidden></span>
        </button>
        <input class="search-input toolbar__search" type="search" data-search placeholder="Buscar evento, academia, ritmo…"
          aria-label="Buscar eventos" autocomplete="off" />
      </div>
    </div>
    <div class="chip-row" id="date-filters" role="group" aria-label="Filtrar por fecha"></div>
    <div class="chip-row" id="type-filters" role="group" aria-label="Filtrar por tipo"></div>
    <div class="chip-row" id="style-filters" role="group" aria-label="Filtrar por ritmo"></div>
    <p class="filter-status" id="filter-status" hidden></p>
  </div>
  <p class="visually-hidden" id="results-status" role="status"></p>
</div>
