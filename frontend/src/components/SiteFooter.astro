---
import Stripes from "./Stripes.astro";
import { ICONS } from "../scripts/lib/icons";
import { feedbackUrl } from "../scripts/lib/links";

interface Props {
  accounts: string[];
}

const { accounts } = Astro.props;
// The version, set by the deploy workflow (scripts/release.mjs), linked to what changed in it. Local builds have none.
const version = import.meta.env.PUBLIC_VERSION;
const releaseUrl = version ? `https://github.com/pa-bailar/pa-bailar.github.io/releases/tag/v${version}` : null;
---

<!-- "Sobre Pa' Bailar": the "Info" link next to the view tabs comes here (#info). -->
<footer class="site-footer" id="info">
  <div class="container">
    <Stripes />
    <h2 class="site-footer__title">Sobre Pa' Bailar</h2>
    <p>
      Los sociales y talleres de baile de Bogotá en un solo lugar.
    </p>
    <p>
      Los datos se leen automáticamente desde Instagram, así que pueden tener errores: confírmalos siempre en
      la publicación original. Los flyers son de cada academia de baile u organizador.
    </p>
    <details class="site-footer__sources">
      <summary><Fragment set:html={ICONS.instagram} /> Fuentes: {accounts.length} cuentas de Instagram</summary>
      <p class="site-footer__links">
        {accounts.map((account) => <a href={`https://www.instagram.com/${account}/`} target="_blank" rel="noopener">@{account}</a>)}
      </p>
    </details>
    <p class="site-footer__install" data-install-offer hidden>
      <Fragment set:html={ICONS.phone} />
      <button class="link-button" type="button" data-install data-track="instalar">Instala Pa' Bailar en tu celular</button>{" "}
      y ábrelo como una app.
    </p>
    <p class="site-footer__feedback">
      <Fragment set:html={ICONS.message} /> ¿Un dato está mal o tienes una idea para la app?{" "}
      <a href={feedbackUrl()} target="_blank" rel="noopener" data-track="comentarios">Escríbenos</a>
    </p>
    <div class="site-footer__bottom">
      <p class="site-footer__author">
        <Fragment set:html={ICONS.github} /> Hecho por{" "}
        <a href="https://github.com/jzamora5" target="_blank" rel="noopener" data-track="github">@jzamora5</a>
      </p>
      {
        releaseUrl && (
          <a class="site-footer__version" href={releaseUrl} target="_blank" rel="noopener" data-track="version">
            versión {version}
          </a>
        )
      }
    </div>
  </div>
</footer>
