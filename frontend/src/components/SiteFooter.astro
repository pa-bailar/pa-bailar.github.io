---
import Stripes from "./Stripes.astro";
import { ICONS } from "../scripts/lib/icons";
import { BASE_URL } from "../scripts/lib/links";

interface Props {
  accounts: string[];
}

const { accounts } = Astro.props;
// Subscribe links for the daily calendar feed (pages/calendario.ics.ts).
const feedUrl = new URL(`${BASE_URL}calendario.ics`, Astro.site);
const webcalUrl = feedUrl.href.replace(/^https?:/, "webcal:");
const googleUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcalUrl)}`;
---

<!-- "Sobre Pa' Bailar": the "Info" link next to the view tabs comes here (#info). -->
<footer class="site-footer" id="info">
  <div class="container">
    <Stripes />
    <h2 class="site-footer__title">Sobre Pa' Bailar</h2>
    <p>
      Los sociales y talleres de baile de Bogotá en un solo lugar.
    </p>
    <p>
      Los datos se leen automáticamente de cada flyer y su texto, así que pueden tener errores: confírmalos
      siempre en la publicación original. Los flyers son de cada academia.
    </p>
    <div class="site-footer__subscribe">
      <p><Fragment set:html={ICONS.calendar} /> Suscríbete y los eventos nuevos aparecen solos en tu calendario:</p>
      <p class="site-footer__links">
        <a href={googleUrl} target="_blank" rel="noopener" data-track="suscripcion-google">Google Calendar</a>
        <a href={webcalUrl} data-track="suscripcion-ical">iPhone y otros calendarios</a>
      </p>
      <p class="site-footer__note">Tu calendario lo actualiza una o dos veces al día.</p>
    </div>
    <details class="site-footer__sources">
      <summary><Fragment set:html={ICONS.instagram} /> Fuentes: {accounts.length} cuentas de Instagram</summary>
      <p class="site-footer__links">
        {accounts.map((account) => <a href={`https://www.instagram.com/${account}/`} target="_blank" rel="noopener">@{account}</a>)}
      </p>
    </details>
    <p class="site-footer__author">
      <Fragment set:html={ICONS.github} /> Hecho por{" "}
      <a href="https://github.com/jzamora5" target="_blank" rel="noopener" data-track="github">@jzamora5</a>
    </p>
  </div>
</footer>
