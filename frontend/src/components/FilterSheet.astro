---
// "Filtros" (phones, from Filtros in the bar at the bottom): every date, rhythm and type with how many events each would show, the
// academy chosen from a card, and the switch "Ocultar eventos de bares" (remembered). Choices apply at once; "Ver 12 eventos" stays at the bottom and closes it.
// It slides up from the bottom and drags down to close (lib/sheet.ts). Filled by scripts/views/filters.ts.
---

<dialog class="sheet sheet-panel filter-sheet" id="filter-sheet" aria-labelledby="filter-sheet-title">
  <span class="sheet-handle" aria-hidden="true"></span>
  <div class="sheet-panel__head filter-sheet__head">
    <h2 class="sheet-panel__title" id="filter-sheet-title">Filtros</h2>
    <button class="filter-sheet__clear" id="filter-sheet-clear" type="button" data-clear-filters>Limpiar</button>
    <button class="icon-btn" type="button" data-close-sheet aria-label="Cerrar">×</button>
  </div>
  <div class="filter-sheet__body" id="filter-sheet-body"></div>
  <div class="filter-sheet__foot">
    <button class="btn btn--primary" type="button" data-close-sheet id="filter-sheet-results">Ver eventos</button>
  </div>
</dialog>
