---
// HTML shell shared by every page: meta tags, fonts, design system styles and the theme pre-paint script.
//
// Styles are imported one by one (not chained with CSS @import) so the dev server reloads each file
// when it changes. Order matters: tokens → base → components.
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components/stripes.css";
import "../styles/components/buttons.css";
import "../styles/components/tags.css";
import "../styles/components/site-header.css";
import "../styles/components/toolbar.css";
import "../styles/components/sheet.css";
import "../styles/components/jump-bar.css";
import "../styles/components/view-switch.css";
import "../styles/components/filter-sheet.css";
import "../styles/components/event-card.css";
import "../styles/components/calendar.css";
import "../styles/components/event-dialog.css";
import "../styles/components/site-footer.css";

import { BASE_URL } from "../scripts/lib/links";
import { DAY_START_HOUR, NIGHT_START_HOUR, THEME_COLORS, THEME_STORAGE_KEY } from "../scripts/themeConfig";

interface Props {
  title: string;
  description: string;
  /** Path of an image under the site's public folder (e.g. a flyer) for link previews. */
  image?: string | null;
  /** Pages that shouldn't be indexed (the 404): no canonical URL, robots noindex. */
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(`${BASE_URL}${image}`, Astro.site) : null;

// Record-label favicon in the brand colors (wine + marigold).
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>" +
      "<circle cx='32' cy='32' r='30' fill='#2A0F14'/><circle cx='32' cy='32' r='14' fill='#F2C12E'/>" +
      "<circle cx='32' cy='32' r='3' fill='#2A0F14'/></svg>",
  );
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Link previews (WhatsApp, Instagram, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Pa' Bailar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content={THEME_COLORS.light} />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Bodoni+Moda:ital,opsz,wght@1,6..96,500&family=Instrument+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- Apply the theme before first paint so the page never flashes the wrong one. Same rules as
         resolveTheme() in scripts/theme.ts (saved mode, else by the hour), same settings (themeConfig.ts). -->
    <script
      is:inline
      define:vars={{ storageKey: THEME_STORAGE_KEY, dayStart: DAY_START_HOUR, nightStart: NIGHT_START_HOUR, colors: THEME_COLORS }}
    >
      var mode = "auto";
      try {
        var saved = localStorage.getItem(storageKey);
        if (saved === "light" || saved === "dark") mode = saved;
      } catch (e) {}
      var hour = new Date().getHours();
      var theme = mode === "auto" ? (hour >= dayStart && hour < nightStart ? "light" : "dark") : mode;
      var root = document.documentElement;
      root.dataset.theme = theme;
      root.dataset.themeMode = mode;
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", colors[theme]);
    </script>
    <slot name="head" />
    <!-- Visit statistics without cookies (scripts/lib/analytics.ts). -->
    <script is:inline data-goatcounter="https://jzamora9.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
