---
// HTML shell shared by every page: meta tags, fonts, design system styles and the theme pre-paint script.
// Astro adds the Content Security Policy's <meta> (astro.config.mjs); scripts/csp-meta.mjs moves it to the top.
//
// Styles are imported one by one (not chained with CSS @import) so the dev server reloads each file
// when it changes. Order matters: tokens → base → components.
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components/stripes.css";
import "../styles/components/buttons.css";
import "../styles/components/tags.css";
import "../styles/components/site-header.css";
import "../styles/components/toolbar.css";
import "../styles/components/sheet.css";
import "../styles/components/jump-bar.css";
import "../styles/components/bottom-nav.css";
import "../styles/components/posts-sheet.css";
import "../styles/components/post-viewer.css";
import "../styles/components/filter-sheet.css";
import "../styles/components/filters.css";
import "../styles/components/event-card.css";
import "../styles/components/calendar.css";
import "../styles/components/event-detail.css";
import "../styles/components/drawer.css";
import "../styles/components/site-footer.css";
import "../styles/components/install.css";

// GoatCounter's count.js, served from this site (so the CSP allows no other script host): vendor/.
import goatcounterScript from "../vendor/goatcounter-count.js?url";
import { allowInlineScript } from "../csp";
import { BASE_URL } from "../scripts/lib/links";
import { THEME_COLORS } from "../scripts/themeConfig";
import { BRAND, ICON_MARIGOLD } from "../scripts/lib/brandColors";
import { themePrePaintScript } from "../themeScript";

/** A link preview's image: its path under the site root (with its ?v= version, if any) and what apps need to
 * show it on the first share (size, type) and to describe it (alt). */
export interface PreviewImage {
  path: string;
  width: number;
  height: number;
  type: string;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  /** The link preview's title, when it says more than the page's (an event's date); otherwise `title`. */
  previewTitle?: string;
  /** The link preview's image (WhatsApp, Instagram, iMessage, Telegram, Facebook). */
  image?: PreviewImage | null;
  /** Pages that shouldn't be indexed (the 404): no canonical URL, robots noindex. */
  noindex?: boolean;
}

const { title, description, previewTitle = title, image, noindex = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(`${BASE_URL}${image.path}`, Astro.site) : null;

// Record-label favicon in the brand colors (wine + marigold).
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>" +
      `<circle cx='32' cy='32' r='30' fill='${BRAND.wine900}'/><circle cx='32' cy='32' r='14' fill='${ICON_MARIGOLD}'/>` +
      `<circle cx='32' cy='32' r='3' fill='${BRAND.wine900}'/></svg>`,
  );

// The theme before first paint (themeScript.ts): light unless the visitor chose Oscuro. Inline, allowed by its hash.
const themeScript = allowInlineScript(Astro, themePrePaintScript);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Link previews (WhatsApp, Instagram, iMessage, Telegram, Facebook). The image's size and type let an app
         show it on the very first share, before it has downloaded it. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Pa' Bailar" />
    <meta property="og:title" content={previewTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {
      image && imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:secure_url" content={imageUrl} />
          <meta property="og:image:type" content={image.type} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={previewTitle} />
    <meta name="twitter:description" content={description} />
    {image && imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {image && <meta name="twitter:image:alt" content={image.alt} />}
    <meta name="theme-color" content={THEME_COLORS.light} />
    <link rel="icon" href={favicon} />
    <!-- Installing it like an app (pages/manifest.webmanifest.ts, scripts/views/installPrompt.ts) -->
    <link rel="manifest" href={`${BASE_URL}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${BASE_URL}icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="Pa' Bailar" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Bodoni+Moda:ital,opsz,wght@1,6..96,500&family=Instrument+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- The theme before first paint (themeScript, above). -->
    <script is:inline set:html={themeScript} />
    <slot name="head" />
    <!-- Visit statistics without cookies (scripts/lib/analytics.ts), with our copy of GoatCounter's script. -->
    <script is:inline data-goatcounter="https://jzamora9.goatcounter.com/count" async src={goatcounterScript}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
